#!/usr/local/munkireport/munkireport-python3

import os
import subprocess
import sys

sys.path.insert(0, '/usr/local/munki')
sys.path.insert(0, '/usr/local/munkireport')

from munkilib import FoundationPlist


def get_prefs():
    paths = []

    # Get all users' home folders
    cmd = ['dscl', '.', '-readall', '/Users', 'NFSHomeDirectory']
    proc = subprocess.Popen(cmd, shell=False, bufsize=-1,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    (output, unused_error) = proc.communicate()

    for user in output.decode().split('\n'):
        if 'NFSHomeDirectory' in user and '/var/empty' not in user:
            userpath = user.replace("NFSHomeDirectory: ", "") + '/Library/Preferences/com.teamviewer.teamviewer.preferences.Machine.plist'
            if os.path.isfile(userpath):
                paths.append(userpath)

    system_pref = '/Library/Preferences/com.teamviewer.teamviewer.preferences.plist'
    if os.path.isfile(system_pref):
        paths.append(system_pref)

    return paths


def client_id_from(pl):
    """Prefer ClientID_64. TeamViewer IDs do not always fit in a 32-bit int."""
    for key in ('ClientID_64', 'ClientID'):
        if key not in pl:
            continue
        value = pl[key]
        if isinstance(value, bool):
            continue
        if isinstance(value, int):
            if value < 0:
                continue
            return str(value)
        if isinstance(value, str):
            text = value.strip()
            if text.isdigit():
                return text
    return ''


def as_text_list(value):
    if isinstance(value, (bytes, bytearray)):
        return ''
    if isinstance(value, str) or not hasattr(value, '__iter__'):
        if isinstance(value, str):
            return value.strip()
        if isinstance(value, int) and not isinstance(value, bool):
            return str(value)
        return ''
    parts = []
    for item in value:
        if isinstance(item, str):
            text = item.strip()
        elif isinstance(item, int) and not isinstance(item, bool):
            text = str(item)
        else:
            continue
        if text:
            parts.append(text)
    return "\n".join(parts)


def fill(row, key, value):
    if value in ('', None):
        return
    if row.get(key) in ('', None):
        row[key] = value


def process_prefs(paths):
    rows = {}
    order = []

    for pref in paths:
        try:
            pl = FoundationPlist.readPlist(pref)
            clientid = client_id_from(pl)
        except Exception:
            continue
        if not clientid:
            continue

        if clientid not in rows:
            rows[clientid] = {'clientid': clientid, 'prefpath': pref}
            order.append(clientid)
        row = rows[clientid]
        apply_fields(row, pl)

        # User preferences have no Client ID. Fold them into the machine record.
        if pref.endswith('.preferences.Machine.plist'):
            sibling = pref.replace('.preferences.Machine.plist', '.preferences.plist')
            if os.path.isfile(sibling):
                try:
                    apply_fields(row, FoundationPlist.readPlist(sibling))
                except Exception:
                    pass

    result = [rows[clientid] for clientid in order]
    for row in result:
        keep_newer_updates(row)
    return result


def apply_fields(row, pl):
    field_map = (
        ('Always_Online', 'always_online'),
        ('AutoUpdateMode', 'autoupdatemode'),
        ('Had_a_commercial_Connection', 'had_a_commercial_connection'),
        ('IPC_Port_Service', 'ipc_port_service'),
        ('LicenseType', 'licensetype'),
        ('MIDVersion', 'midversion'),
        ('MoveRestriction', 'moverestriction'),
        ('Security_Adminrights', 'security_adminrights'),
        ('Security_PasswordStrength', 'security_passwordstrength'),
        ('Is_Not_First_Run_Without_Connection', 'is_not_first_run_without_connection'),
        ('Is_Not_Running_Test_Connection', 'is_not_running_test_connection'),
        ('Update_Available', 'update_available'),
        ('ClientIC', 'clientic'),
        ('Meeting_UserName', 'meeting_username'),
        ('OwningManagerAccountName', 'owning_manager_account_name'),
        ('OwningManagerCompanyName', 'owning_manager_company_name'),
        ('Unmanaged', 'unmanaged'),
        ('BuddyLoginName', 'buddy_login_name'),
        ('BuddyDisplayName', 'buddy_display_name'),
        ('UIVersion', 'ui_version'),
        ('UseNewUI', 'use_new_ui'),
    )
    for source, dest in field_map:
        if source in pl:
            fill(row, dest, pl[source])

    if 'Version' in pl and isinstance(pl['Version'], str):
        fill(row, 'version', pl['Version'].strip())
    if 'LastMACUsed' in pl:
        fill(row, 'lastmacused', as_text_list(pl['LastMACUsed']))
    # A later plist replaces the update list, including an empty list.
    if 'UpdateVersion' in pl:
        row['updateversion'] = as_text_list(pl['UpdateVersion'])


def version_key(text):
    nums = []
    for part in str(text).strip().split('.'):
        if part.isdigit():
            nums.append(int(part))
        else:
            break
    return tuple(nums)


def keep_newer_updates(row):
    """Drop advertised updates that are not newer than the installed version."""
    installed = version_key(row.get('version') or '')
    listed = []
    for item in str(row.get('updateversion') or '').split('\n'):
        item = item.strip()
        if not item:
            continue
        if installed and version_key(item) and version_key(item) <= installed:
            continue
        listed.append(item)
    if listed:
        row['updateversion'] = '\n'.join(listed)
        return
    row.pop('updateversion', None)
    if installed and row.get('update_available') not in ('', None):
        row['update_available'] = 0


def main():
    """Main"""

    result = process_prefs(get_prefs())

    cachedir = '%s/cache' % os.path.dirname(os.path.realpath(__file__))
    output_plist = os.path.join(cachedir, 'teamviewer.plist')
    FoundationPlist.writePlist(result, output_plist)

if __name__ == "__main__":
    main()
